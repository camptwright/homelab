# Copy to .env and fill. Never commit .env.
# Generate passwords: openssl rand -hex 24

# --- domain + cloudflare ---
DOMAIN=example.com                      # your real domain, DNS on Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=                # from Zero Trust > Networks > Tunnels
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                          # Access application AUD tag

# --- databases ---
POSTGRES_SUPER_PASSWORD=
DASHBOARD_DB_PASSWORD=
MINIFLUX_DB_PASSWORD=
ADJUTANT_DB_PASSWORD=
MARKETS_DB_PASSWORD=

# --- llm ---
ANTHROPIC_API_KEY=
LITELLM_API_KEY=sk-homelab-anything-long

# --- apps ---
MINIFLUX_ADMIN_PASSWORD=
MINIFLUX_TOKEN=                         # created in Miniflux UI after first login
LINKDING_PASSWORD=
# The Add System dialog's UUID is NOT this value - that broke the agent
# once (crash-looped with "ssh: no key found"). The real public key is
# derived from the hub's own persisted keypair:
#   ssh-keygen -y -f $(docker volume inspect homelab_beszel --format {{.Mountpoint}})/id_ed25519
# QUOTE the value - it contains a space ("ssh-ed25519 AAAA...") and an
# unquoted .env line with a space breaks `source .env` (used by the A5
# password-rotation runbook and various debug scripts): bash tries to
# execute the second word as a command.
BESZEL_AGENT_KEY=""
BESZEL_API_EMAIL=dashboard-api@internal.local  # dedicated service account, not a personal login
BESZEL_API_PASSWORD=                    # created via: docker compose exec beszel /beszel superuser upsert <email> <password>
UPTIME_KUMA_STATUS_SLUG=dashboard-internal      # public status page the dashboard's System tile reads
ADJUTANT_API_TOKEN=                     # same value as in .env.adjutant
ARTICLE_INGEST_TOKEN=                   # bearer token OpenClaw uses to POST articles
FANTASY_EDGE_URL=http://10.51.24.80:8000 # CT 100, fantasy-edge LXC's API container, direct port
MARKETS_API_TOKEN=                      # openssl rand -hex 32; bearer token for the marketdesk API
FINNHUB_API_KEY=                        # optional - enables Finnhub as the 1st-choice quote provider
ALPHAVANTAGE_API_KEY=                   # optional - enables Alpha Vantage as the 2nd-choice quote provider
