# Copy to .env.adjutant on CT110 and replace every placeholder.
# This file documents the complete environment contract; it contains no secrets.

DATABASE_URL=postgresql+asyncpg://adjutant:example@postgres:5432/adjutant
API_BEARER_TOKEN=example-adjutant-token

LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=example-litellm-key
AGENT_MODEL_ALIAS=worker

UPTIME_KUMA_STATUS_URL=http://uptime-kuma:3001/api/status-page/dashboard-internal

MARKETS_URL=http://marketdesk:8000
MARKETS_API_TOKEN=example-markets-token
FANTASY_EDGE_URL=http://fantasy-edge.example.internal:8000

DASHBOARD_INGEST_URL=http://dashboard:3000/api/ingest/articles
ARTICLE_INGEST_TOKEN=example-article-token

# PVEAuditor (read-only) + a custom VM.PowerMgmt-only role, both granted
# to a dedicated adjutant@pve user - see homelab SETUP.md's Proxmox note.
PROXMOX_URL=https://reekserver:8006/api2/json
PROXMOX_NODE=reekserver
PROXMOX_TOKEN_ID=adjutant@pve!adjutant
PROXMOX_TOKEN_SECRET=example-proxmox-token-secret
# Proxmox's self-signed cert, pinned rather than verify=False. Exported
# once via `ssh root@&lt;proxmox-host&gt; cat /etc/pve/pve-root-ca.pem` and
# committed to the homelab repo as proxmox-ca.pem (public CA cert, not a
# secret) - bind-mounted into the container at this path.
PROXMOX_CA_CERT_PATH=/app/proxmox-ca.pem

SCHEDULER_TIMEZONE=America/Chicago
LOG_LEVEL=INFO
ENVIRONMENT=production
